{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "countries_en.schema.json",
  "title": "World Countries — English Names Backbone",
  "description": "Canonical list of every UN-recognized country with English name and ISO 3166-1 codes. This is the spine that all other datasets (hunger, conflict, climate, economy) join against.",
  "type": "object",
  "required": [
    "countries"
  ],
  "properties": {
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name_en",
          "iso2",
          "iso3"
        ],
        "properties": {
          "name_en": {
            "type": "string",
            "description": "Official short English name"
          },
          "name_pt": {
            "type": "string",
            "description": "Nome em português (opcional)"
          },
          "iso2": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 code"
          },
          "iso3": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 3166-1 alpha-3 code"
          },
          "un_m49": {
            "type": "integer",
            "description": "UN M49 numeric region/country code"
          },
          "region": {
            "type": "string",
            "enum": [
              "Africa",
              "Americas",
              "Asia",
              "Europe",
              "Oceania"
            ],
            "description": "UN continental region"
          },
          "subregion": {
            "type": "string",
            "description": "UN subregion (e.g. Sub-Saharan Africa, Western Asia)"
          },
          "is_un_member": {
            "type": "boolean",
            "description": "True if UN member state"
          }
        }
      }
    }
  },
